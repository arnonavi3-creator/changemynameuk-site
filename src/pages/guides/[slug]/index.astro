---
// One page per guide file in src/content/guides/.
import { getCollection, render } from 'astro:content';
import Guide from '../../../layouts/Guide.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}
const { guide } = Astro.props;
const { Content } = await render(guide);
---
<Guide guide={guide}><Content /></Guide>
