---
import Base from '../../../layouts/Base.astro';
---
<Base
  title={"Pick a Time for Your Call | Change My Name UK"}
  description={"Pick a time for your 15 minute research call."}
  path={"/call/thanks/"}
  ogTitle={"Pick a Time for Your Call"}
  noindex
>
<main id="main" class="wrap narrow">
  <div class="page-head">
    <h1 id="call-thanks-title">Thank you! Now pick a time</h1>
    <p class="lede">Choose a 15 minute slot that suits you. You'll get a calendar invite by email, and your £7 Amazon voucher after the call.</p>
  </div>

  <!-- Booking page: Avi's Google Calendar appointment schedule. Change the link in data-booking-url
       to use a different booking page. While it's empty, visitors see the fallback message. -->
  <div id="booking" data-booking-url="https://calendar.app.google/pwMDAwBcUqVqyk9m6">
    <div id="booking-embed" class="cta-box" hidden>
      <p><a class="button" id="booking-open" href="#" rel="noopener" target="_blank">Choose a time for your call</a></p>
      <p class="fine">Opens our booking calendar in a new tab. Pick any 15 minute slot and you'll get a calendar invite by email.</p>
    </div>
    <div id="booking-fallback" class="cta-box">
      <p><b>We'll email you within 2 working days with a few times to choose from.</b> If none of them suit, just reply with a time that does.</p>
    </div>
  </div>

  <p class="mt">While you wait, your <a href="/check/">checklist</a> is saved on this device, so you can carry on ticking things off.</p>
</main>
<script is:inline>
(function () {
  var box = document.getElementById('booking');
  var url = box.getAttribute('data-booking-url');
  var name = null;
  try { name = sessionStorage.getItem('cmn-call-name'); } catch (e) { name = null; }
  if (name) document.getElementById('call-thanks-title').textContent = 'Thank you, ' + name + '! Now pick a time';
  if (!url) {
    document.getElementById('call-thanks-title').textContent = name ? 'Thank you, ' + name + '!' : 'Thank you!';
    document.querySelector('.page-head .lede').textContent = 'We\'ll be in touch soon to arrange your 15 minute call. Your £7 Amazon voucher comes after the call.';
    return;
  }
  document.getElementById('booking-open').href = url;
  document.getElementById('booking-embed').hidden = false;
  document.getElementById('booking-fallback').hidden = true;
})();
</script>
</Base>
