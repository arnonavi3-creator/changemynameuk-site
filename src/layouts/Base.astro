---
// Every page uses this layout: <head> tags, header, footer.
// Page content goes in the default slot. Extra <head> tags (structured data,
// preloads) go in slot="head"; page scripts go in slot="scripts".
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title: string;            // full <title>
  description?: string;
  path?: string;            // e.g. "/about/" (canonical and og:url)
  ogTitle?: string;
  ogType?: 'website' | 'article';
  ogImageAlt?: string;
  noindex?: boolean;
  bodyClass?: string;
  navCurrent?: string;      // header link to mark as the current page
  footerSeals?: boolean;
  footerGoingBack?: boolean;
}
const {
  title, description, path, ogTitle, ogType = 'website',
  ogImageAlt = 'Change My Name UK: a free checklist of every place to update when you change your name',
  noindex = false, bodyClass, navCurrent, footerSeals = false, footerGoingBack = false,
} = Astro.props;
---
<!doctype html>
<html lang="en-GB">
<head>
<SeoHead title={title} description={description} path={path} ogTitle={ogTitle} ogType={ogType} ogImageAlt={ogImageAlt} noindex={noindex} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Playfair+Display:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Caveat:wght@500;700&display=swap">
<link rel="stylesheet" href="/style.css">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<slot name="head" />
<script is:inline defer src="/js/analytics.js"></script>
</head>
<body class={bodyClass}>

<a class="skip" href="#main">Skip to content</a>
<Header current={navCurrent} />

<slot />

<Footer seals={footerSeals} goingBack={footerGoingBack} />

<slot name="scripts" />
</body>
</html>
